{
  "schema_version": 1,
  "note": "项目自定义路由元数据，不会被所有 Agent 客户端自动执行。README 和 AGENTS.md 引导执行者显式使用。每条路由只展开匹配的具体条目，不读取全部模板。",
  "routes": [
    {
      "id": "orientation",
      "title": "理解项目",
      "keywords": [
        "概述",
        "上手",
        "项目",
        "orientation"
      ],
      "must_read": [
        "docs/project/overview.md",
        "docs/engineering/development/quickstart.md"
      ],
      "read_when": [
        {
          "condition": "需要了解系统边界",
          "paths": [
            "docs/engineering/architecture/overview.md"
          ]
        }
      ],
      "write_back": []
    },
    {
      "id": "feature",
      "title": "实现或修改功能",
      "keywords": [
        "功能",
        "feature",
        "需求"
      ],
      "must_read": [
        "docs/product/features/README.md",
        "docs/tests/strategy.md",
        "docs/work/items/README.md"
      ],
      "read_when": [
        {
          "condition": "跨模块边界",
          "paths": [
            "docs/engineering/architecture/overview.md"
          ]
        },
        {
          "condition": "涉及用户界面",
          "paths": [
            "docs/design/README.md",
            "docs/product/pages/README.md"
          ]
        },
        {
          "condition": "涉及接口、数据或权限",
          "paths": [
            "docs/contracts/README.md",
            "docs/db/README.md",
            "docs/security/access-control.md"
          ]
        }
      ],
      "write_back": [
        "docs/product/features/README.md",
        "docs/tests/cases/README.md",
        "docs/work/items/README.md"
      ]
    },
    {
      "id": "bug",
      "title": "复现与修复 Bug",
      "keywords": [
        "bug",
        "缺陷",
        "修复"
      ],
      "must_read": [
        "docs/work/items/README.md",
        "docs/product/features/README.md",
        "docs/tests/strategy.md"
      ],
      "read_when": [
        {
          "condition": "线上问题",
          "paths": [
            "docs/operations/runbooks/README.md",
            "docs/operations/incidents/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/tests/cases/README.md",
        "docs/tests/reports/README.md",
        "docs/work/items/README.md"
      ]
    },
    {
      "id": "ui",
      "title": "页面、流程与组件",
      "keywords": [
        "UI",
        "页面",
        "设计",
        "交互"
      ],
      "must_read": [
        "docs/design/principles.md",
        "docs/product/pages/README.md",
        "docs/design/components/README.md"
      ],
      "read_when": [
        {
          "condition": "跨功能路径",
          "paths": [
            "docs/product/journeys/README.md"
          ]
        },
        {
          "condition": "外部设计核验",
          "paths": [
            "docs/design/assets/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/product/pages/README.md",
        "docs/design/components/README.md",
        "docs/tests/cases/README.md"
      ]
    },
    {
      "id": "api",
      "title": "API 或事件变更",
      "keywords": [
        "api",
        "接口",
        "事件",
        "webhook"
      ],
      "must_read": [
        "docs/contracts/README.md",
        "docs/security/access-control.md",
        "docs/tests/strategy.md"
      ],
      "read_when": [
        {
          "condition": "影响数据库或第三方",
          "paths": [
            "docs/db/README.md",
            "docs/operations/services/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/contracts/api/README.md",
        "docs/contracts/events/README.md",
        "docs/tests/cases/README.md"
      ]
    },
    {
      "id": "database",
      "title": "数据库与数据迁移",
      "keywords": [
        "数据库",
        "迁移",
        "schema",
        "database"
      ],
      "must_read": [
        "docs/db/overview.md",
        "docs/db/migrations/README.md",
        "docs/db/lifecycle/README.md"
      ],
      "read_when": [
        {
          "condition": "涉及生产或恢复",
          "paths": [
            "docs/_system/execution-policy.md",
            "docs/operations/backup/README.md"
          ]
        },
        {
          "condition": "改变收集、保留或删除",
          "paths": [
            "docs/legal/privacy/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/db/entities/README.md",
        "docs/db/migrations/README.md",
        "docs/tests/reports/README.md"
      ]
    },
    {
      "id": "billing",
      "title": "订阅、价格、支付与权益",
      "keywords": [
        "billing",
        "支付",
        "订阅",
        "定价",
        "退款"
      ],
      "must_read": [
        "docs/product/features/README.md",
        "docs/business/pricing/README.md",
        "docs/legal/refunds/README.md",
        "docs/security/access-control.md"
      ],
      "read_when": [
        {
          "condition": "涉及回调或第三方状态",
          "paths": [
            "docs/contracts/events/README.md",
            "docs/operations/services/README.md"
          ]
        },
        {
          "condition": "涉及展示与通知",
          "paths": [
            "docs/support/faq/README.md",
            "docs/marketing/copy/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/product/features/README.md",
        "docs/tests/cases/README.md",
        "docs/business/pricing/README.md",
        "docs/support/faq/README.md"
      ]
    },
    {
      "id": "environment",
      "title": "环境、配置与依赖",
      "keywords": [
        "环境",
        "配置",
        "密钥",
        "environment"
      ],
      "must_read": [
        "docs/operations/environments/README.md",
        "docs/operations/configuration/README.md",
        "docs/security/secrets.md"
      ],
      "read_when": [
        {
          "condition": "涉及外部服务或费用",
          "paths": [
            "docs/operations/services/README.md",
            "docs/operations/costs/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/_system/project-map.json",
        "docs/_system/commands.json",
        "docs/operations/configuration/README.md"
      ]
    },
    {
      "id": "release",
      "title": "发布与恢复",
      "keywords": [
        "发布",
        "部署",
        "回滚",
        "release"
      ],
      "must_read": [
        "docs/_system/execution-policy.md",
        "docs/releases/checklists/README.md",
        "docs/operations/deployment/README.md",
        "docs/releases/entries/README.md"
      ],
      "read_when": [
        {
          "condition": "包含数据库变化",
          "paths": [
            "docs/db/migrations/README.md"
          ]
        },
        {
          "condition": "包含用户承诺变化",
          "paths": [
            "docs/legal/README.md",
            "docs/business/pricing/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/releases/entries/README.md",
        "docs/tests/reports/README.md"
      ]
    },
    {
      "id": "incident",
      "title": "线上事故",
      "keywords": [
        "故障",
        "事故",
        "线上",
        "incident"
      ],
      "must_read": [
        "docs/_system/execution-policy.md",
        "docs/operations/runbooks/README.md",
        "docs/operations/incidents/README.md"
      ],
      "read_when": [
        {
          "condition": "外部服务故障",
          "paths": [
            "docs/operations/services/README.md"
          ]
        },
        {
          "condition": "安全事故",
          "paths": [
            "docs/security/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/operations/incidents/README.md",
        "docs/work/reviews/README.md",
        "docs/work/items/README.md"
      ]
    },
    {
      "id": "metrics",
      "title": "埋点、指标与实验",
      "keywords": [
        "指标",
        "埋点",
        "实验",
        "metrics"
      ],
      "must_read": [
        "docs/product/metrics/README.md",
        "docs/contracts/events/README.md"
      ],
      "read_when": [
        {
          "condition": "收集或处理个人数据",
          "paths": [
            "docs/db/lifecycle/README.md",
            "docs/legal/privacy/README.md"
          ]
        },
        {
          "condition": "开展实验",
          "paths": [
            "docs/product/experiments/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/product/metrics/README.md",
        "docs/contracts/events/README.md",
        "docs/product/experiments/README.md"
      ]
    },
    {
      "id": "business",
      "title": "商业、路线图与研究",
      "keywords": [
        "商业",
        "路线图",
        "市场",
        "竞品",
        "business"
      ],
      "must_read": [
        "docs/project/overview.md",
        "docs/business/model.md",
        "docs/research/README.md"
      ],
      "read_when": [
        {
          "condition": "阶段取舍",
          "paths": [
            "docs/product/roadmap/README.md"
          ]
        },
        {
          "condition": "定价决策",
          "paths": [
            "docs/business/pricing/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/business/assumptions/README.md",
        "docs/product/roadmap/README.md",
        "docs/research/studies/README.md"
      ]
    },
    {
      "id": "marketing",
      "title": "营销和内容发布",
      "keywords": [
        "营销",
        "内容",
        "SEO",
        "marketing"
      ],
      "must_read": [
        "docs/marketing/positioning.md",
        "docs/marketing/copy/README.md",
        "docs/marketing/content/README.md"
      ],
      "read_when": [
        {
          "condition": "包含功能、价格或政策承诺",
          "paths": [
            "docs/product/features/README.md",
            "docs/business/pricing/README.md",
            "docs/legal/README.md"
          ]
        },
        {
          "condition": "需要对外发布或费用",
          "paths": [
            "docs/_system/execution-policy.md"
          ]
        }
      ],
      "write_back": [
        "docs/marketing/content/README.md",
        "docs/marketing/campaigns/README.md"
      ]
    },
    {
      "id": "support",
      "title": "客服与反馈",
      "keywords": [
        "客服",
        "反馈",
        "support"
      ],
      "must_read": [
        "docs/support/faq/README.md",
        "docs/support/cases/README.md",
        "docs/research/feedback/README.md"
      ],
      "read_when": [
        {
          "condition": "订阅、退款或账户操作",
          "paths": [
            "docs/legal/refunds/README.md",
            "docs/_system/execution-policy.md"
          ]
        }
      ],
      "write_back": [
        "docs/support/cases/README.md",
        "docs/research/feedback/README.md",
        "docs/work/items/README.md"
      ]
    },
    {
      "id": "legal",
      "title": "政策与条款",
      "keywords": [
        "隐私",
        "条款",
        "政策",
        "legal"
      ],
      "must_read": [
        "docs/legal/README.md",
        "docs/_system/authority.md",
        "docs/_system/execution-policy.md"
      ],
      "read_when": [
        {
          "condition": "隐私与数据",
          "paths": [
            "docs/db/lifecycle/README.md",
            "docs/operations/services/README.md"
          ]
        },
        {
          "condition": "收费与退款",
          "paths": [
            "docs/business/pricing/README.md",
            "docs/legal/refunds/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/legal/README.md",
        "docs/releases/entries/README.md"
      ]
    },
    {
      "id": "security",
      "title": "安全与权限",
      "keywords": [
        "安全",
        "权限",
        "security"
      ],
      "must_read": [
        "docs/security/baseline.md",
        "docs/security/access-control.md",
        "docs/_system/execution-policy.md"
      ],
      "read_when": [
        {
          "condition": "密钥相关",
          "paths": [
            "docs/security/secrets.md"
          ]
        },
        {
          "condition": "发现风险",
          "paths": [
            "docs/security/findings/README.md",
            "docs/security/threat-models/README.md"
          ]
        }
      ],
      "write_back": [
        "docs/security/controls/README.md",
        "docs/security/findings/README.md",
        "docs/work/items/README.md"
      ]
    },
    {
      "id": "docs",
      "title": "文档维护",
      "keywords": [
        "文档",
        "docs"
      ],
      "must_read": [
        "docs/AGENTS.md",
        "docs/_system/conventions.md",
        "docs/_system/authority.md"
      ],
      "read_when": [
        {
          "condition": "新增类型或大规模迁移",
          "paths": [
            "docs/_system/lifecycle.md",
            "docs/_system/collections.json"
          ]
        },
        {
          "condition": "修改工具适配",
          "paths": [
            "docs/_system/tool-adapters.md"
          ]
        }
      ],
      "write_back": [
        "docs/_system/routes.json",
        "docs/_generated/README.md"
      ]
    }
  ]
}
