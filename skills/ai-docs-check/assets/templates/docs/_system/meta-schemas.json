{
  "schema_version": 1,
  "description": "文档平面 JSON 标量元数据规则；未知事实可用 null，正文充分性由 AI/人工判断。required 是键存在要求，nullable 是字段值要求。保留未知扩展字段；与别的类型专属字段混用仍属错误。",
  "common": {
    "required": [
      "id",
      "type",
      "status",
      "summary",
      "owner",
      "applies_to",
      "verified_at",
      "verification_ref",
      "authority"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "type": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "status": {
        "type": "string",
        "enum": [
          "template",
          "draft",
          "active",
          "deprecated",
          "archived"
        ]
      },
      "summary": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "owner": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "applies_to": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "verified_at": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-or-date-time"
      },
      "verification_ref": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "authority": {
        "type": "string",
        "enum": [
          "normative",
          "descriptive",
          "evidence",
          "procedure"
        ]
      }
    }
  },
  "additionalProperties": {
    "type": [
      "string",
      "number",
      "boolean",
      "null"
    ]
  },
