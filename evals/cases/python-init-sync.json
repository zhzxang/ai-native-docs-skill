{
  "version": 1,
  "id": "python-init-sync",
  "title": "Python CLI 初始化并同步来源可追溯的草案",
  "project": "python-cli",
  "tags": [
    "init",
    "sync",
    "python",
    "facts"
  ],
  "prompt": "请先使用 ai-docs-init 初始化 {project}，再使用 ai-docs-sync 从本地代码和 pyproject.toml 同步最小架构与开发入口草案。我授权预览及应用两项计划，计划放在 {plans}。保留源码、示例数据和测试；本轮仅生成尚未核验的草案，核验和批准字段保持未知。",
  "steps": [
    {
      "action": "init",
      "plan": "init.json"
    },
    {
      "action": "sync",
      "plan": "sync.json"
    }
  ],
  "assertions": [
    {
      "kind": "exists",
      "paths": [
        "README.md",
        "AGENTS.md",
        "docs/README.md",
        "docs/AGENTS.md",
        "docs/.ai-docs.json"
      ]
    },
    {
      "kind": "absent",
      "paths": [
        "docs/_system",
        "docs/_templates",
        "docs/_tools",
        "docs/_generated"
      ]
    },
    {
      "kind": "doc_check",
      "expected_exit": 0
    },
    {
      "kind": "exists",
      "paths": [
        "docs/engineering/architecture/overview.md",
        "docs/engineering/development/quickstart.md"
      ]
    },
    {
      "kind": "unchanged",
      "paths": [
        ".gitignore",
        "pyproject.toml",
        "inventory_cli/__init__.py",
        "inventory_cli/__main__.py",
        "inventory_cli/cli.py",
        "inventory_cli/store.py",
        "data/example.json",
        "tests/test_inventory.py"
      ]
    },
    {
      "kind": "only_changes",
      "allowed": [
        "README.md",
        "AGENTS.md",
        "docs/README.md",
        "docs/AGENTS.md",
        "docs/.ai-docs.json",
        "docs/engineering/architecture/overview.md",
        "docs/engineering/development/quickstart.md"
      ]
    },
    {
      "kind": "doc_meta",
      "path": "docs/engineering/architecture/overview.md",
      "fields": {
        "id": "ARCH-OVERVIEW",
        "type": "architecture-overview",
        "status": "draft",
        "verified_at": null,
        "verification_ref": null,
        "authority": "descriptive"
      }
    },
    {
      "kind": "doc_meta",
      "path": "docs/engineering/development/quickstart.md",
      "fields": {
        "id": "DEV-QUICKSTART",
        "type": "development-guide",
        "status": "draft",
        "verified_at": null,
        "verification_ref": null,
        "authority": "procedure",
        "approved_by": null,
        "approval_ref": null
      }
    },
    {
      "kind": "record_count",
      "type": "architecture-overview",
      "count": 1
    },
    {
      "kind": "record_count",
      "type": "development-guide",
      "count": 1
    },
    {
      "kind": "contains",
      "path": "docs/engineering/architecture/overview.md",
      "texts": [
        "inventory_cli",
        "pyproject.toml"
      ]
    },
    {
      "kind": "contains",
      "path": "docs/engineering/development/quickstart.md",
      "text": "pyproject.toml"
    },
    {
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "inventory_cli",
        "--data",
        "data/example.json",
        "list"
      ],
      "expected_exit": 0,
      "stdout_contains": "Pencil\t3\nNotebook\t2\n"
    }
  ]
}
