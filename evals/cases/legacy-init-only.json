{
  "version": 1,
  "id": "legacy-init-only",
  "title": "历史文档项目仅初始化不隐式迁移",
  "project": "legacy-docs",
  "tags": [
    "init",
    "legacy",
    "scope"
  ],
  "prompt": "请使用 ai-docs-init 为 {project} 完成最小初始化，计划放在 {plans}。我授权预览并应用初始化计划。这次仅安装最小入口和配置；历史文档保持原位置与全文，完成后告诉我有哪些后续整理范围。",
  "steps": [
    {
      "action": "init",
      "plan": "init.json"
    }
  ],
  "assertions": [
    {
      "kind": "exists",
      "paths": [
        "README.md",
        "AGENTS.md",
        "docs/README.md",
        "docs/AGENTS.md",
        "docs/.ai-docs.json"
      ]
    },
    {
      "kind": "absent",
      "paths": [
        "docs/_system",
        "docs/_templates",
        "docs/_tools",
        "docs/_generated"
      ]
    },
    {
      "kind": "doc_check",
      "expected_exit": 0
    },
    {
      "kind": "unchanged",
      "paths": [
        "legacy/architecture.md",
        "legacy/storage-decision.md",
        "legacy/assets/ledger-flow.svg",
        "notes/out-of-scope.md"
      ]
    },
    {
      "kind": "only_changes",
      "allowed": [
        "README.md",
        "AGENTS.md",
        "docs/README.md",
        "docs/AGENTS.md",
        "docs/.ai-docs.json"
      ]
    },
    {
      "kind": "absent",
      "paths": [
        "docs/engineering/architecture/overview.md",
        "docs/engineering/adrs.md"
      ]
    },
    {
      "kind": "record_count",
      "type": "architecture-overview",
      "count": 0
    },
    {
      "kind": "record_count",
      "type": "adr",
      "count": 0
    }
  ]
}
